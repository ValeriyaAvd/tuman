    {
      "color": "#cc88ff",
      "draworder": "topdown",
      "id": 8,
      "name": "Story",
      "objects": [
        {
          "height": 32,
          "id": 914,
          "name": "house_1",
          "opacity": 1,
          "properties": [
            {
              "name": "approach",
              "type": "string",
              "value": "Шторы задёрнуты. Все до единой."
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"Я постучал. На секунду штора на втором этаже дрогнула.\", \"Больше никто не подходит к окну.\"]"
            },
            {
              "name": "kind",
              "type": "string",
              "value": "house"
            }
          ],
          "rotation": 0,
          "type": "spot",
          "visible": true,
          "width": 48,
          "x": 568,
          "y": 284
        },
        {
          "height": 32,
          "id": 915,
          "name": "house_2",
          "opacity": 1,
          "properties": [
            {
              "name": "approach",
              "type": "string",
              "value": "На крыльце мокрые следы. Они ведут внутрь... и обратно не выходят."
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"Заперто. Ручка мокрая и холодная, будто её только что кто-то трогал.\"]"
            },
            {
              "name": "kind",
              "type": "string",
              "value": "house"
            }
          ],
          "rotation": 0,
          "type": "spot",
          "visible": true,
          "width": 48,
          "x": 1576,
          "y": 284
        },
        {
          "height": 32,
          "id": 916,
          "name": "house_3",
          "opacity": 1,
          "properties": [
            {
              "name": "approach",
              "type": "string",
              "value": "Дома стоят так, будто люди вышли на минуту и не вернулись."
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"Дверь заперта. За ней тихо.\", \"Я постучал ещё раз. Тишина... но мне кажется, за дверью кто-то стоит.\"]"
            },
            {
              "name": "kind",
              "type": "string",
              "value": "house"
            }
          ],
          "rotation": 0,
          "type": "spot",
          "visible": true,
          "width": 48,
          "x": 200,
          "y": 284
        },
        {
          "height": 32,
          "id": 917,
          "name": "house_4",
          "opacity": 1,
          "properties": [
            {
              "name": "approach",
              "type": "string",
              "value": "На двери что-то нацарапано."
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"«НЕ ВЫХОДИ ИЗ ДОМА». Буквы процарапаны изнутри.\", \"Заперто. Кто бы это ни писал, он, похоже, послушался.\"]"
            },
            {
              "name": "kind",
              "type": "string",
              "value": "house"
            }
          ],
          "rotation": 0,
          "type": "spot",
          "visible": true,
          "width": 48,
          "x": 1192,
          "y": 316
        },
        {
          "height": 32,
          "id": 918,
          "name": "house_5",
