    {
      "id": 8,
      "name": "Story",
      "type": "objectgroup",
      "draworder": "topdown",
      "opacity": 1,
      "visible": true,
      "color": "#cc88ff",
      "objects": [
        {
          "id": 99,
          "name": "shelf_1",
          "type": "spot",
          "rotation": 0,
          "visible": true,
          "x": 24,
          "y": 56,
          "width": 80,
          "height": 32,
          "properties": [
            {
              "name": "kind",
              "type": "string",
              "value": "shelf"
            },
            {
              "name": "approach",
              "type": "string",
              "value": ""
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"Консервы. Срок годности истёк десять лет назад.\", \"На одной банке детский рисунок вместо этикетки. Тот же дом у воды.\"]"
            }
          ]
        },
        {
          "id": 100,
          "name": "shelf_2",
          "type": "spot",
          "rotation": 0,
          "visible": true,
          "x": 120,
          "y": 56,
          "width": 80,
          "height": 32,
          "properties": [
            {
              "name": "kind",
              "type": "string",
              "value": "shelf"
            },
            {
              "name": "approach",
              "type": "string",
              "value": ""
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"Полки в пыли. Кроме одного места — отсюда что-то взяли совсем недавно.\"]"
            }
          ]
        },
        {
          "id": 101,
          "name": "shelf_3",
          "type": "spot",
          "rotation": 0,
          "visible": true,
          "x": 24,
          "y": 88,
          "width": 80,
          "height": 32,
          "properties": [
            {
              "name": "kind",
              "type": "string",
              "value": "shelf"
            },
            {
              "name": "approach",
              "type": "string",
              "value": ""
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"Пакеты с крупой прогрызены. Но мышей здесь не слышно. Вообще ничего не слышно.\"]"
            }
          ]
        },
        {
          "id": 102,
          "name": "shelf_4",
          "type": "spot",
          "rotation": 0,
          "visible": true,
          "x": 120,
          "y": 88,
          "width": 80,
          "height": 32,
          "properties": [
            {
              "name": "kind",
              "type": "string",
              "value": "shelf"
            },
            {
              "name": "approach",
              "type": "string",
              "value": ""
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"Игрушки. Резиновая уточка... У брата была точно такая же.\", \"Я взял её в руки. Она мокрая.\"]"
            }
          ]
        },
        {
          "id": 103,
          "name": "counter_5",
          "type": "spot",
          "rotation": 0,
          "visible": true,
          "x": 152,
          "y": 120,
          "width": 64,
          "height": 32,
          "properties": [
            {
              "name": "kind",
              "type": "string",
              "value": "counter"
            },
            {
              "name": "approach",
              "type": "string",
              "value": "Касса ещё включена."
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"На экране последняя покупка: «Батарейки — 2 шт.». Дата стёрта.\", \"В ящике кассы ни денег, ни чеков. Только мокрый песок.\"]"
            }
          ]
        },
        {
          "id": 104,
          "name": "fridge_6",
          "type": "spot",
          "rotation": 0,
          "visible": true,
          "x": 12,
          "y": 20,
          "width": 56,
          "height": 40,
          "properties": [
            {
              "name": "kind",
              "type": "string",
              "value": "fridge"
            },
            {
              "name": "approach",
              "type": "string",
              "value": "Холодильники гудят. Единственный звук здесь, кроме моих шагов."
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"Бутылки с водой. Все пустые, но крышки закручены.\", \"На стекле изнутри отпечаток ладони. Маленькой.\"]"
            }
          ]
        },
        {
          "id": 105,
          "name": "back_door_7",
          "type": "spot",
          "rotation": 0,
          "visible": true,
          "x": 172,
          "y": 32,
          "width": 24,
          "height": 14,
          "properties": [
            {
              "name": "kind",
              "type": "string",
              "value": "back_door"
            },
            {
              "name": "approach",
              "type": "string",
              "value": "Дверь в подсобку. «Только для персонала»."
            },
            {
              "name": "inspect",
              "type": "string",
              "value": "[\"Заперто. Изнутри что-то скребётся... и затихает, когда я прислушиваюсь.\", \"Ключа нет. Может, он где-то в посёлке.\"]"
            }
          ]
        },
        {
          "id": 106,
          "name": "remark",
          "type": "remark",
          "rotation": 0,
          "visible": true,
          "x": 16,
          "y": 144,
          "width": 224,
          "height": 32,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "Внутри пахнет пылью и прокисшим молоком. И ещё чем-то... сладковатым."
            }
          ]
        },
        {
          "id": 107,
          "name": "remark",
          "type": "remark",
          "rotation": 0,
          "visible": true,
          "x": 144,
          "y": 32,
          "width": 96,
          "height": 32,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "Здесь холоднее. Будто сквозняк тянет из-за той двери."
            }
          ]
        }
      ]
    }
